# ─────────────────────────────────────────────────────────────────────────────
# HOPE2 ACADEMY — frontend BUILD-TIME environment
# These are baked into the static bundle at build time (Vite). They are NOT
# secrets. The deploy script (03-deploy-app.sh) already sets these defaults, so
# you normally do NOT need this file — it documents the values for reference.
# ─────────────────────────────────────────────────────────────────────────────

# API base path. For the single-domain deploy the API lives at /api on the same
# origin as the site, so this is simply "/api".
VITE_API_BASE_URL=/api

# Public base path the SPA is served from. The site is at the domain root, so "/".
BASE_PATH=/

# Required so Vite excludes Replit-only dev plugins from the production bundle.
NODE_ENV=production
