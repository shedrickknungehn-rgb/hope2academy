# ─────────────────────────────────────────────────────────────────────────────
# HOPE2 ACADEMY — API server production environment
# Copy this file to  deploy/.env.production  and fill in the real values.
# It is loaded by PM2 (deploy/pm2/ecosystem.config.cjs) and by the deploy script.
# NEVER commit the filled-in deploy/.env.production — it is gitignored.
# Avoid spaces and the characters  # : @ ' "  inside values (URL / shell / SQL unsafe).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (self-hosted on THIS VPS, localhost only).
# Format: postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# The setup script (02-setup-database.sh) reads these credentials from this URL.
DATABASE_URL=postgresql://hope2:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/hope2_academy

# Port the Node API listens on (local only — Nginx proxies to it).
# If you change this, also update the `upstream` port in deploy/nginx/hope2-academy.conf.
PORT=5000

# Bind address. Keep 127.0.0.1 so the API is reachable ONLY through Nginx,
# never directly from the public internet.
HOST=127.0.0.1

# Secret used to sign login (JWT) tokens. MUST be set in production.
# Generate a strong value with:   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Google Gemini API key — powers the public AI chat widget.
# Get one at https://aistudio.google.com/apikey
# Leave blank to disable chat gracefully (the endpoint returns 503).
GEMINI_API_KEY=

# Where uploaded media is stored on disk. Must be writable by the app user and
# readable by Nginx. Persistent — include it in your backups.
# If you change this, also update the alias path in deploy/nginx/hope2-academy.conf.
UPLOAD_DIR=/var/lib/hope2-academy/uploads

# Cross-origin control. For the standard single-domain deploy (frontend at / and
# API at /api on the SAME domain) requests are same-origin, so leave this UNSET.
# Only set it (comma-separated origins) if you serve the API on a different domain:
# CORS_ORIGIN=https://www.your-domain.tld

# Optional tuning (sane defaults shown — uncomment to override):
# MAX_UPLOAD_BYTES=15728640   # max upload size in bytes (default 15 MB)
# CHAT_RATE_LIMIT=20          # chat requests per IP per minute (default 20)
# LOG_LEVEL=info              # pino log level

NODE_ENV=production
